# Copy to .env (git-ignored) and replace the placeholders. Never commit .env.
# These values are for the local Docker Compose stack only.

POSTGRES_USER=splits
POSTGRES_PASSWORD=change-me
POSTGRES_DB=splits
POSTGRES_PORT=55432

# development is the only environment where OTP_MODE=fixed (code 123456) is allowed (ADR-0016).
APP_ENV=development
OTP_MODE=fixed

# Used by `go test` in server/. Tests create and drop their own schema in this database.
TEST_DATABASE_URL=postgres://splits:change-me@localhost:55432/splits?sslmode=disable
