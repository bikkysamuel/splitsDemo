      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits"
          }
        }
      }
    },
    "That code didn't work. Check it, or send a new one.": {
      "comment": "Verification error: the code is wrong, expired or used up",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn't work. Check it, or send a new one."
          }
        }
      }
    },
    "That's too much text to send.": {
      "comment": "Error when a request body is over the size limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's too much text to send."
          }
        }
      }
    },
    "The email or password is wrong.": {
      "comment": "Sign-in error: wrong email or password",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The email or password is wrong."
          }
        }
      }
    },
    "This field is invalid.": {
      "comment": "Field error with no more specific message",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This field is invalid."
          }
        }
      }
    },
    "This password is too common. Choose another.": {
      "comment": "Field error: the new password is on the common/breached list",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This password is too common. Choose another."
          }
        }
      }
    },
    "Too many attempts. Wait a moment, then try again.": {
      "comment": "Sign-in error after too many failed attempts",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait a moment, then try again."
          }
        }
      }
    },
    "Try again": {
      "comment": "Button on the launch screen that re-checks the saved session",
