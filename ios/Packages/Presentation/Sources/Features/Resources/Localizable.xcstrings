      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "Use another account": {
      "comment": "Button that leaves verification for sign-in with another account",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use another account"
          }
        }
      }
    },
    "Use at least 10 characters.": {
      "comment": "Field error: the new password is shorter than 10 characters",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least 10 characters."
          }
        }
      }
    },
    "Use at most 128 characters.": {
      "comment": "Field error: the new password is longer than 128 characters",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at most 128 characters."
          }
        }
      }
    },
