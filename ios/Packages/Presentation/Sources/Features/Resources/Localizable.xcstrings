      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify"
          }
        }
      }
    },
    "Verify your email": {
      "comment": "Title of the email verification screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your email"
          }
        }
      }
    },
    "Verify your email first.": {
      "comment": "Error when an unverified User tries something that needs verification",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your email first."
          }
        }
      }
    },
    "We sent a 6-digit code to %@.": {
      "comment": "Header of the verification screen; %@ is the User's email",
