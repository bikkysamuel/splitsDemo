      "comment": "Confirmation after a new verification code was sent",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We sent a new code."
          }
        }
      }
    },
    "Your session has ended. Sign in again.": {
      "comment": "Error when the saved session is no longer valid",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has ended. Sign in again."
          }
        }
      }
    },
    "you@example.com": {
      "comment": "Placeholder of the email field",
